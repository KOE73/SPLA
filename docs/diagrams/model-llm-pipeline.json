    "layout": "message-flow"
  },
  "views": [
    {
      "id": "full_pipeline",
      "name": "Весь конвейер (Full Pipeline)",
      "icon": "🔄",
      "description": "Complete flow from user prompt through contributors to model and output parser"
    },
    {
      "id": "contributors_view",
      "name": "Сборка контекста (Contributors)",
      "icon": "🧩",
      "description": "Typed context contributors producing system prompt slices",
      "highlightZones": [
        "zone_contributors"
      ],
      "highlightNodes": [
        "composer",
        "contrib_system",
        "contrib_skills",
        "contrib_tools",
        "contrib_history"
      ]
    },
    {
      "id": "output_view",
      "name": "Обработка ответа (Output Stage)",
      "icon": "⚡",
      "description": "Streaming token parser, tool call detection, and thinking block extraction",
