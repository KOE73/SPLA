      "type": "call"
    },
    {
      "id": "p2",
      "from": "composer",
      "to": "contrib_system",
      "label": "pull slice",
      "type": "data-flow"
    },
    {
      "id": "p3",
      "from": "composer",
      "to": "contrib_skills",
      "label": "pull slice",
      "type": "data-flow"
    },
    {
      "id": "p4",
      "from": "composer",
      "to": "contrib_tools",
      "label": "pull slice",
      "type": "data-flow"
    },
    {
      "id": "p5",
      "from": "composer",
      "to": "contrib_history",
      "label": "pull slice",
      "type": "data-flow"
    },
    {
