      "x": 310,
      "y": 40,
      "width": 460,
      "height": 480,
      "styleId": "domain.llm.composition",
      "metadata": {
        "description": "Ordered typed contributors combining system instructions, skills, active tools, and memory."
      }
    },
    {
      "id": "zone_model",
      "name": "3. Model Execution",
      "type": "external-system",
      "semanticId": "zone.llm.gateway",
      "tags": [
        "model",
        "gateway"
