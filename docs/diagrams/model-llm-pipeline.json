    {
      "id": "zone_input",
      "name": "1. Input & Trigger",
      "type": "boundary",
      "semanticId": "zone.llm.input",
      "tags": [
        "input",
        "chat"
      ],
      "x": 40,
      "y": 40,
      "width": 240,
      "height": 480,
      "styleId": "domain.llm.input",
      "metadata": {
        "description": "User turn trigger, active conversation context, and attachments."
      }
    },
    {
      "id": "zone_contributors",
      "name": "2. Typed Context Assembly (Contributors)",
      "type": "subsystem",
      "semanticId": "zone.llm.composition",
      "tags": [
        "composition",
        "contributors",
        "prompt"
