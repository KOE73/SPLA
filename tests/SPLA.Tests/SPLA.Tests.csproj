<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Windows-targeted: the domain scenario (per-user areas, group sharing) is proven against a
         real WindowsIdentity, so the suite exercises the actual platform it ships on. -->
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Several tests verify real wall-clock behaviour (LocalShell's silence-based prompt
         detection, the progress rate limiter's coalescing window, ChatPump's self-feed debounce,
         RoslynPlugin.CheckHealth's cold-compile timeout) by racing short, hand-tuned Task.Delay
         margins against the actual OS scheduler. xUnit's default collection-level parallelism runs
         every test class concurrently, and under a loaded CI runner that contention alone can push
         real elapsed time past those margins — see the flaky failures across InteractiveShellTests,
         McpStdioServerTests, ChatPumpTests and PluginSelfCheckTests.Roslyn that motivated this file.
         Serializing collections gives every timing-sensitive test the runner to itself, which is
         what its margin was actually tuned against. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\agent\SPLA.Agent\SPLA.Agent.csproj" />
    <ProjectReference Include="..\..\src\agent\SPLA.MCP.BasicTools\SPLA.MCP.BasicTools.csproj" />
    <ProjectReference Include="..\..\src\core\SPLA.Domain\SPLA.Domain.csproj" />
    <ProjectReference Include="..\..\src\service\SPLA.Mcp\SPLA.Mcp.csproj" />
    <ProjectReference Include="..\..\src\service\SPLA.Mcp.Client\SPLA.Mcp.Client.csproj" />
    <ProjectReference Include="..\..\src\llm\SPLA.LLM.OpenAiCompat\SPLA.LLM.OpenAiCompat.csproj" />
    <ProjectReference Include="..\..\src\core\SPLA.Secrets.Dpapi\SPLA.Secrets.Dpapi.csproj" />
    <ProjectReference Include="..\..\src\plugins\SPLA.Plugins.Ssh\SPLA.Plugins.Ssh.csproj" />
    <ProjectReference Include="..\..\src\plugins\SPLA.Plugins.Browser\SPLA.Plugins.Browser.csproj" />
    <ProjectReference Include="..\..\src\plugins\SPLA.Plugins.Browser.Screencast\SPLA.Plugins.Browser.Screencast.csproj" />
    <ProjectReference Include="..\..\src\plugins\SPLA.Plugins.Network\SPLA.Plugins.Network.csproj" />
    <ProjectReference Include="..\..\src\plugins\SPLA.Plugins.OneC\SPLA.Plugins.OneC.csproj" />
    <ProjectReference Include="..\..\src\plugins\SPLA.Plugins.Roslyn\SPLA.Plugins.Roslyn.csproj" />
