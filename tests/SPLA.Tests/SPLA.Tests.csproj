    <ProjectReference Include="..\..\src\plugins\SPLA.Plugins.Documents\SPLA.Plugins.Documents.csproj" />
    <ProjectReference Include="..\..\src\service\SPLA.Service\SPLA.Service.csproj" />
    <ProjectReference Include="..\..\src\service\SPLA.Instances\SPLA.Instances.csproj" />
    <ProjectReference Include="..\..\src\identity\SPLA.Identity.Windows\SPLA.Identity.Windows.csproj" />
  </ItemGroup>

</Project>
