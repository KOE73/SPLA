<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\agent\SPLA.Agent\SPLA.Agent.csproj" />
    <ProjectReference Include="..\..\core\SPLA.Domain\SPLA.Domain.csproj" />
    <ProjectReference Include="..\..\core\SPLA.Secrets.Dpapi\SPLA.Secrets.Dpapi.csproj" />
    <ProjectReference Include="..\..\core\SPLA.Observability\SPLA.Observability.csproj" />
    <ProjectReference Include="..\..\service\SPLA.Service\SPLA.Service.csproj" />
    <ProjectReference Include="..\..\service\SPLA.Mcp\SPLA.Mcp.csproj" />
    <ProjectReference Include="..\..\service\SPLA.Instances\SPLA.Instances.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the help_mcp flag works from anywhere without reading a sibling file, and also
         copied next to the exe (both in bin\ and every publish output) so it ships as a plain,
         greppable MCP_USAGE.md in the product zip. -->
    <EmbeddedResource Include="Assets\MCP_USAGE.md" LogicalName="SPLA.CLI.MCP_USAGE.md" />
    <Content Include="Assets\MCP_USAGE.md" CopyToOutputDirectory="PreserveNewest" Link="MCP_USAGE.md" />
    <!-- RU translation for humans only: plain shipped file, deliberately NOT embedded, so
         the help_mcp flag never returns it and a foreign MCP head always gets the English source. -->
    <Content Include="Assets\MCP_USAGE_RU.md" CopyToOutputDirectory="PreserveNewest" Link="MCP_USAGE_RU.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.55.0" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Single-file/self-contained live in Properties\PublishProfiles\SingleFile.pubxml, not here, so
         that only a publish is RID-specific. Setting them in the project body made every `dotnet build`
         carry them too, and a hard-coded SelfContained=false here is exactly the thing that shipped a
         zip needing a runtime the machine did not have. -->
  </PropertyGroup>

</Project>
