<?xml version="1.0" encoding="utf-8"?>
<!--
  Same shape as the desktop app's profile, and that is the point. SPLA.UI.Avalonia spawns this exe as
  its service child, so a zip whose UI is self-contained and whose CLI is not produces the worst
  possible symptom on a machine without the runtime: the window opens, looks fine, and everything
  behind it is dead — the child exits instantly with FrameworkMissingFailure and the shell reports
  only a health-check timeout. Note it is the ASP.NET Core runtime that is missing in that case, not
  just the .NET one (SPLA.Service takes a FrameworkReference on Microsoft.AspNetCore.App), which is a
  distinction nobody should have to discover from a hex exit code.

  Only publishes use this profile; a plain `dotnet build` stays RID-less and framework-dependent, so
  the dev tree keeps its bin\<cfg>\<tfm>\ layout that EmbeddedServiceLauncher.FindDevCliDll walks.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\.publish\SPLA.CLI\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <Target Name="RemovePublishSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishSymbols)" />
  </Target>
</Project>
