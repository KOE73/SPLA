<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The SPLA service host: wraps the agent core (same stack the CLI builds) behind a WebSocket
    protocol so any client — the Avalonia thin client, a browser, a phone — drives one agent the
    same way, whether it is in-process (embedded) or across the network (remote).
  -->

  <PropertyGroup>
    <!-- Minimal ASP.NET host for the WebSocket endpoint + static web client assets later. -->
    <UseAspNet>true</UseAspNet>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseAspNet)' == 'true'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Negotiate (NTLM/Kerberos) auth for the server host. Not in the shared framework — a separate
         package. Only enforced when ServiceOptions.RequireAuthentication is set (the SPLA.Server host);
         loopback/embedded stays auth-free. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.10" />
  </ItemGroup>

  <!-- OTLP export (Grafana/Tempo/Jaeger/Datadog/…). Only active when an OTLP endpoint is configured;
       ships out the same "SPLA" meter/traces the local stats collector taps in-process. -->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
  </ItemGroup>

  <!-- The browser client (web/, Vue 3 + TS + Vite) builds to web/dist before each build, then
       ships embedded — the service stays self-contained with no content-root/wwwroot wiring at
       runtime. LogicalName is set explicitly so it still resolves to "SPLA.Service.WebClient.*",
       matching WebAssets.cs — files outside the project cone otherwise lose their directory path. -->
  <PropertyGroup>
    <WebClientDir>$(MSBuildThisFileDirectory)..\..\..\web</WebClientDir>
    <!-- Written after a successful install; its age is what says whether the installed tree still
         matches the manifests. -->
    <WebClientInstallStamp>$(WebClientDir)\node_modules\.spla-install-stamp</WebClientInstallStamp>
  </PropertyGroup>

  <!-- Dependencies, installed whenever the manifests are newer than the last install.
       NOT "install if node_modules is missing", which is what this used to say: that condition is
       true exactly once per checkout, so every dependency added afterwards never arrives. Whoever
       already had the folder got a type error naming the new package (vitest, in the case that
       exposed this), and the only cure was knowing to run npm install by hand.
       Inputs/Outputs make it incremental, so an up-to-date tree still costs nothing. -->
  <Target Name="RestoreWebClient" BeforeTargets="BuildWebClient"
          Condition="Exists('$(WebClientDir)\package.json')"
          Inputs="@(WebClientManifest)" Outputs="$(WebClientInstallStamp)">
    <Exec Command="npm install" WorkingDirectory="$(WebClientDir)" />
    <Touch Files="$(WebClientInstallStamp)" AlwaysCreate="true" />
  </Target>

  <ItemGroup>
    <!-- A wildcard, so a checkout without a lockfile yields no item rather than a missing input. -->
    <WebClientManifest Include="$(WebClientDir)\package*.json" />
  </ItemGroup>

  <Target Name="BuildWebClient" BeforeTargets="BeforeBuild" DependsOnTargets="RestoreWebClient"
          Condition="Exists('$(WebClientDir)\package.json')">
    <Exec Command="npm run build" WorkingDirectory="$(WebClientDir)" />
  </Target>

  <!-- Glob the embedded resources INSIDE a target that runs after the web build, not as a static
       ItemGroup. A static glob is evaluated at project-load time and captures the PREVIOUS build's
       hashed filenames (index-<hash>.js/css); BuildWebClient then regenerates dist with NEW hashes,
       so the compiler was handed items pointing at files that no longer exist — the first
       `dotnet build` after editing any web source failed with CS1566 ("could not find
       index-<hash>.css") and only a second run, re-evaluated against the fresh dist, succeeded.
       Running the glob at BeforeCompile (after BuildWebClient) always sees the just-produced files. -->
  <!-- Single hook + DependsOnTargets="BuildWebClient" so the target runs exactly ONCE, after the web
       build and before the resources are prepared. Hooking both AfterTargets and BeforeTargets makes
       MSBuild execute the body at BOTH injection points, adding the same items twice → CS1508
       (duplicate resource identifier).

       BeforeTargets="AssignTargetPaths", NOT "CoreCompile". CoreCompile never reads @(EmbeddedResource):
       PrepareResources (AssignTargetPaths → CreateManifestResourceNames → SplitResourcesByCulture →
       ResGen) turns that list into @(_CoreCompileResourceInputs), and THAT is what the compiler is
       handed. Hooking CoreCompile ran this target long after the list had been read, so the items went
       into a collection nobody looks at again — SPLA.Service.dll shipped with ZERO manifest resources.
       "BeforeTargets=PrepareResources" is not enough either, and looks like it should be: BeforeTargets
       appends to the target's DependsOnTargets, so it runs after PrepareResources' own dependencies —
       which is where all the resource processing lives. AssignTargetPaths is the first of them.

       This survived unnoticed because the embedded copy is only ever read when WebAssets finds no
       web/dist on disk, and a publish made INTO the repo (.publish\work) still walks up and finds the
       repo's own. Only a zip extracted somewhere else had nothing to fall back to — and answered 404 to
       every page request. AssignTargetPaths still runs well after BuildWebClient (forced below via
       DependsOnTargets), so the glob keeps seeing the bundle this build just produced, which is the
       whole reason it is a target and not a static ItemGroup. -->
  <Target Name="EmbedWebClient" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildWebClient"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\web\dist')">
    <ItemGroup>
      <!-- Two steps, and it has to be two. Reading %(RecursiveDir) inside a property function on the
           SAME item being declared yields an empty string — every file then got the identical logical
           name "SPLA.Service.WebClient." and the compiler rejected the set with CS1508. (That is the
           duplicate-identifier error this file's history blamed on double target hooks.) Metadata
           qualified by another item's name — %(WebClientFile.RecursiveDir) — batches correctly. -->
      <WebClientFile Include="..\..\..\web\dist\**\*.*" />
      <EmbeddedResource Include="@(WebClientFile)">
        <LogicalName>SPLA.Service.WebClient.$([System.String]::new('%(WebClientFile.RecursiveDir)%(WebClientFile.Filename)%(WebClientFile.Extension)').Replace('\', '.'))</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <!-- The build must not be able to succeed without the client inside it again. A distribution has no
       web/dist to read from, so a missing index.html resource is not a degraded build — it is a build
       that answers 404 to its own home page, and it looks perfectly healthy right up until someone
       unzips it on a machine that is not this one. -->
  <Target Name="VerifyWebClientEmbedded" AfterTargets="PrepareResources"
          Condition="Exists('$(WebClientDir)\package.json')">
    <Error Condition="'@(EmbeddedResource->WithMetadataValue('LogicalName', 'SPLA.Service.WebClient.index.html'))' == ''"
           Text="The web client was not embedded: no resource named SPLA.Service.WebClient.index.html. A published build serves the browser client from that resource and would answer 404 to every page. Check that web/dist/index.html exists and that EmbedWebClient still runs before PrepareResources." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\service\SPLA.Service.Contracts\SPLA.Service.Contracts.csproj" />
    <ProjectReference Include="..\..\agent\SPLA.Agent\SPLA.Agent.csproj" />
    <ProjectReference Include="..\..\agent\SPLA.Runtime\SPLA.Runtime.csproj" />
    <ProjectReference Include="..\..\core\SPLA.Domain\SPLA.Domain.csproj" />
    <ProjectReference Include="..\..\llm\SPLA.LLM.LMStudio\SPLA.LLM.LMStudio.csproj" />
    <ProjectReference Include="..\..\llm\SPLA.LLM.OpenAiCompat\SPLA.LLM.OpenAiCompat.csproj" />
    <ProjectReference Include="..\..\agent\SPLA.MCP.BasicTools\SPLA.MCP.BasicTools.csproj" />
    <ProjectReference Include="..\..\core\SPLA.MCP.Core\SPLA.MCP.Core.csproj" />
    <ProjectReference Include="..\..\core\SPLA.Observability\SPLA.Observability.csproj" />
    <ProjectReference Include="..\..\service\SPLA.Instances\SPLA.Instances.csproj" />
    <ProjectReference Include="..\..\service\SPLA.Mcp\SPLA.Mcp.csproj" />
    <!-- SSH mechanics for the live xterm terminal bridge (phase B), shared with the SSH plugin. -->
    <ProjectReference Include="..\..\core\SPLA.Ssh.Core\SPLA.Ssh.Core.csproj" />
  </ItemGroup>

</Project>
