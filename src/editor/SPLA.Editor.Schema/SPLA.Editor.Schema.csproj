<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Paths to the single-file web build outputs that get embedded into the DLL. -->
    <EditorWebDir>$(MSBuildThisFileDirectory)web</EditorWebDir>
    <EditorWebBundle>$(EditorWebDir)\dist\index.html</EditorWebBundle>
    <TextWebDir>$(MSBuildThisFileDirectory)web-text</TextWebDir>
    <TextWebBundle>$(TextWebDir)\dist\index.html</TextWebBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\SPLA.Domain\SPLA.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wildcards, so a checkout without a lockfile yields no item rather than a missing input. -->
    <EditorWebManifest Include="$(EditorWebDir)\package*.json" />
    <TextWebManifest Include="$(TextWebDir)\package*.json" />
  </ItemGroup>

  <!-- Dependencies for both bundles, installed whenever the manifests are newer than the last
       install. NOT "install if node_modules is missing": that is true exactly once per checkout, so
       any dependency added later never arrives and the build fails naming a package that IS in
       package.json. Inputs/Outputs keep incremental builds free, which is what the old condition was
       reaching for. -->
  <Target Name="RestoreEditorWeb"
          BeforeTargets="BuildEditorWeb"
          Inputs="@(EditorWebManifest)"
          Outputs="$(EditorWebDir)\node_modules\.spla-install-stamp">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(EditorWebDir)" />
    <Touch Files="$(EditorWebDir)\node_modules\.spla-install-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="RestoreTextWeb"
          BeforeTargets="BuildTextWeb"
          Inputs="@(TextWebManifest)"
          Outputs="$(TextWebDir)\node_modules\.spla-install-stamp">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(TextWebDir)" />
    <Touch Files="$(TextWebDir)\node_modules\.spla-install-stamp" AlwaysCreate="true" />
  </Target>

  <!-- Build the JSON Forms schema-editor bundle (Node, build-time only) before compiling. -->
  <Target Name="BuildEditorWeb"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="RestoreEditorWeb"
          Inputs="$(EditorWebDir)\package.json;$(EditorWebDir)\vite.config.ts;@(EditorWebSource)"
          Outputs="$(EditorWebBundle)">
    <ItemGroup>
      <EditorWebSource Include="$(EditorWebDir)\src\**\*.*" />
      <EditorWebSource Include="$(EditorWebDir)\index.html" />
    </ItemGroup>
    <Exec Command="npm run build"
          WorkingDirectory="$(EditorWebDir)" />
  </Target>

  <!-- Build the CodeMirror text-editor bundle (Node, build-time only) before compiling. -->
  <Target Name="BuildTextWeb"
          BeforeTargets="BeforeBuild"
          DependsOnTargets="RestoreTextWeb"
          Inputs="$(TextWebDir)\package.json;$(TextWebDir)\vite.config.ts;@(TextWebSource)"
          Outputs="$(TextWebBundle)">
    <ItemGroup>
      <TextWebSource Include="$(TextWebDir)\src\**\*.*" />
      <TextWebSource Include="$(TextWebDir)\index.html" />
    </ItemGroup>
    <Exec Command="npm run build"
          WorkingDirectory="$(TextWebDir)" />
  </Target>

  <!-- Embed both built bundles as resources. Logical names are stable regardless of folder layout. -->
  <ItemGroup>
    <EmbeddedResource Include="$(EditorWebBundle)" Condition="Exists('$(EditorWebBundle)')">
      <LogicalName>SPLA.Editor.Schema.editor.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="$(TextWebBundle)" Condition="Exists('$(TextWebBundle)')">
      <LogicalName>SPLA.Editor.Schema.text.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
