<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\core\SPLA.Domain\SPLA.Domain.csproj" />
    <ProjectReference Include="..\..\core\SPLA.MCP.Core\SPLA.MCP.Core.csproj" />
    <ProjectReference Include="..\..\core\SPLA.Observability\SPLA.Observability.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!-- Core prompt fragments, one per built-in agent feature (see AgentFeatureCatalog). Each file sits
       next to its feature's id below; SystemPromptBuilder loads them by this exact logical name. -->
  <ItemGroup>
    <EmbeddedResource Include="Features\CoreWorkspace\prompt.md" LogicalName="SPLA.Agent.Features.CoreWorkspace.prompt.md" />
    <EmbeddedResource Include="Features\CoreDiscipline\prompt.md" LogicalName="SPLA.Agent.Features.CoreDiscipline.prompt.md" />
    <EmbeddedResource Include="Features\CoreMemory\prompt.md" LogicalName="SPLA.Agent.Features.CoreMemory.prompt.md" />
    <EmbeddedResource Include="Features\CoreCheckpoints\prompt.md" LogicalName="SPLA.Agent.Features.CoreCheckpoints.prompt.md" />
    <EmbeddedResource Include="Features\CoreSkills\prompt.md" LogicalName="SPLA.Agent.Features.CoreSkills.prompt.md" />
    <EmbeddedResource Include="Features\CoreBlobs\prompt.md" LogicalName="SPLA.Agent.Features.CoreBlobs.prompt.md" />
    <EmbeddedResource Include="Features\CoreToolSets\prompt.md" LogicalName="SPLA.Agent.Features.CoreToolSets.prompt.md" />
    <EmbeddedResource Include="Features\CoreShell\prompt.md" LogicalName="SPLA.Agent.Features.CoreShell.prompt.md" />
    <EmbeddedResource Include="Features\CoreBackgroundTasks\prompt.md" LogicalName="SPLA.Agent.Features.CoreBackgroundTasks.prompt.md" />
    <EmbeddedResource Include="Features\CoreRoles\prompt.md" LogicalName="SPLA.Agent.Features.CoreRoles.prompt.md" />
  </ItemGroup>

  <!-- The compaction prompt — see CompactPrompt.cs and ADR_20260911-3_agent_compaction.md §2.4. -->
  <ItemGroup>
    <EmbeddedResource Include="Prompts\compact.md" LogicalName="SPLA.Agent.Prompts.compact.md" />
  </ItemGroup>

</Project>
