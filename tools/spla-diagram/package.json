{
  "name": "@spla/diagram",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Semantic architecture diagram canvas and editor. Fixed coordinates, no auto-layout.",
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "main": "./dist/spla-diagram.js",
  "module": "./dist/spla-diagram.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/spla-diagram.js"
    },
    "./style.css": "./dist/spla-diagram.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:app": "npm run typecheck && vite build --mode app",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "styles:emit": "node scripts/emit-styles.mjs",
    "check:model": "node scripts/check-model.mjs ../../docs/diagrams/projects ../.."
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/prismjs": "^1.26.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "dockview-core": "^8.2.0",
    "marked": "^18.0.11",
    "prismjs": "^1.30.0"
  }
}
