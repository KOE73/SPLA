<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Major.Minor.Build — three parts, and the last one identifies the release.
         Major/Minor: bumped by hand here, and rarely. Moving Minor is the act of saying
                      "a new chapter starts"; there is no fourth component doing that job.
         Build:       the run number of release.yml, passed in as -p:VersionBuild=<n>.
                      Never set by hand — a release is identified by which CI run produced it.
         A local build gets Build=0, so every local build reports the same version. That is
         deliberate: the number only means something for a package that came out of CI. -->
    <VersionMajor>0</VersionMajor>
    <VersionMinor>2</VersionMinor>
    <VersionBuild Condition="'$(VersionBuild)' == ''">0</VersionBuild>
    <Version>$(VersionMajor).$(VersionMinor).$(VersionBuild)</Version>
    <!-- Assembly/file versions are four-part by .NET convention; pad rather than invent. -->
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
</Project>
