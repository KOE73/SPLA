/.publish/
/.spla/
**/.spla/
/.claude/
/.vs/
**/bin/
**/obj/
*.user

# Node / web build
**/node_modules/
web/dist/
# Library build of @spla/diagram. The app build (docs/diagrams/app/) is
# committed on purpose: run.cmd must keep working without a Node toolchain.
tools/spla-diagram/dist/

# Local environment and secrets
.env
.env.*
*.local
appsettings.*.json
secret.*
secrets.*
credentials.*
*.secret
*.secrets
*.credential
*.credentials
# agents/ and docs/ are documentation, never storage: nothing there is a secret, and a file named
# after one (secrets.md, credentials.md) must not be swallowed by the patterns above. Placed here
# deliberately — the log, database, and private-key patterns below still apply to both folders.
!agents/**
!docs/**

# Logs, crash dumps, and local runtime state
*.log
crash.txt
*.dmp
*.dump
*.tmp
*.temp
*.cache

# Local build log written by build_network.bat
build_output.txt

# Local databases and indexes
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Private keys and certificates
*.key
*.pem
*.pfx
*.p12
*.crt
*.cer
